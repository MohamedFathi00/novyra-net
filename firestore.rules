rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL HELPER PRIMITIVES
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'me40351@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOrgMember(orgId) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function hasOrgRole(orgId, roles) {
      return isOrgMember(orgId) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in roles;
    }

    function hasBusinessEntitlement(userId) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/users/$(userId)/entitlements/current) &&
        get(/databases/$(database)/documents/users/$(userId)/entitlements/current).data.planId == 'business' &&
        get(/databases/$(database)/documents/users/$(userId)/entitlements/current).data.status == 'active'
      );
    }

    // =========================================================================
    // ENTITY VALIDATION HELPERS
    // =========================================================================
    function isValidAdminRegistry(data, adminId) {
      return data.keys().hasAll(['uid', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'grantedAt', 'grantedBy']) &&
        data.uid == adminId &&
        isValidId(data.uid) &&
        data.grantedAt is timestamp &&
        (!('grantedBy' in data) || (data.grantedBy is string && data.grantedBy.size() <= 128));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'accountStatus', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'language', 'accountStatus', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 512)) &&
        (!('language' in data) || (data.language is string && data.language in ['en', 'ar'])) &&
        data.accountStatus in ['active', 'suspended'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'country', 'acceptedTermsAt', 'marketingOptIn', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
        (!('acceptedTermsAt' in data) || (data.acceptedTermsAt is timestamp)) &&
        (!('marketingOptIn' in data) || (data.marketingOptIn is bool)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriptionPlan(data, planId) {
      return planId in ['free', 'pro', 'business'] &&
        data.keys().hasAll([
          'id', 'name', 'nameAr', 'monthlyPriceCents', 'annualPriceCents',
          'currency', 'pricingConfigured', 'active', 'maxHistoryRecords',
          'maxSavedDevices', 'maxAiRequestsPerDay', 'maxOrgMembers',
          'cloudSyncEnabled', 'analyticsEnabled', 'gamingModeEnabled',
          'alertsEnabled', 'exportEnabled', 'teamManagementEnabled', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'nameAr', 'tagline', 'taglineAr', 'monthlyPriceCents',
          'annualPriceCents', 'currency', 'pricingConfigured', 'active',
          'maxHistoryRecords', 'maxSavedDevices', 'maxAiRequestsPerDay',
          'maxOrgMembers', 'cloudSyncEnabled', 'analyticsEnabled',
          'gamingModeEnabled', 'alertsEnabled', 'exportEnabled',
          'teamManagementEnabled', 'features', 'updatedAt'
        ]) &&
        data.id == planId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 80 &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200)) &&
        (!('taglineAr' in data) || (data.taglineAr is string && data.taglineAr.size() <= 200)) &&
        data.monthlyPriceCents is number && data.monthlyPriceCents >= 0 &&
        data.annualPriceCents is number && data.annualPriceCents >= 0 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.pricingConfigured is bool &&
        data.active is bool &&
        data.maxHistoryRecords is number && data.maxHistoryRecords >= -1 &&
        data.maxSavedDevices is number && data.maxSavedDevices >= 0 &&
        data.maxAiRequestsPerDay is number && data.maxAiRequestsPerDay >= 0 &&
        data.maxOrgMembers is number && data.maxOrgMembers >= 0 &&
        data.cloudSyncEnabled is bool &&
        data.analyticsEnabled is bool &&
        data.gamingModeEnabled is bool &&
        data.alertsEnabled is bool &&
        data.exportEnabled is bool &&
        data.teamManagementEnabled is bool &&
        (!('features' in data) || (data.features is list && data.features.size() <= 20 && (data.features.size() == 0 || data.features[0] is string))) &&
        data.updatedAt is timestamp;
    }

    function isValidFeatureFlag(data, flagId) {
      return data.keys().hasAll(['key', 'enabled', 'requiredPlan', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'enabled', 'requiredPlan', 'description', 'updatedAt']) &&
        data.key == flagId &&
        data.key is string && data.key.size() >= 1 && data.key.size() <= 80 &&
        data.enabled is bool &&
        data.requiredPlan in ['free', 'pro', 'business'] &&
        (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
        data.updatedAt is timestamp;
    }

    function isValidCouponCode(data) {
      return data.keys().hasAll(['code', 'discountPercent', 'applicablePlan', 'active', 'maxUses', 'usedCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['code', 'discountPercent', 'applicablePlan', 'active', 'maxUses', 'usedCount', 'expiresAt', 'createdAt', 'updatedAt']) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
        data.discountPercent is number && data.discountPercent >= 1 && data.discountPercent <= 100 &&
        data.applicablePlan in ['all', 'pro', 'business'] &&
        data.active is bool &&
        data.maxUses is number && data.maxUses >= 1 &&
        data.usedCount is number && data.usedCount >= 0 &&
        (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserSubscription(data, userId) {
      return data.keys().hasAll(['userId', 'planId', 'billingCycle', 'status', 'provider', 'cancelAtPeriodEnd', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'planId', 'billingCycle', 'status', 'provider', 'providerSubscriptionId', 'providerCustomerId', 'cancelAtPeriodEnd', 'currentPeriodEnd', 'createdAt', 'updatedAt']) &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.planId in ['free', 'pro', 'business'] &&
        data.billingCycle in ['monthly', 'annual', 'none'] &&
        data.status in ['active', 'trialing', 'past_due', 'canceled', 'incomplete', 'none'] &&
        data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 40 &&
        (!('providerSubscriptionId' in data) || (data.providerSubscriptionId is string && data.providerSubscriptionId.size() <= 160)) &&
        (!('providerCustomerId' in data) || (data.providerCustomerId is string && data.providerCustomerId.size() <= 160)) &&
        data.cancelAtPeriodEnd is bool &&
        (!('currentPeriodEnd' in data) || (data.currentPeriodEnd is string && data.currentPeriodEnd.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPaymentRecord(data, userId) {
      return data.keys().hasAll(['userId', 'planId', 'amountCents', 'currency', 'status', 'provider', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'planId', 'amountCents', 'currency', 'status', 'provider', 'providerSessionId', 'invoiceUrl', 'createdAt']) &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.planId in ['free', 'pro', 'business'] &&
        data.amountCents is number && data.amountCents >= 0 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10 &&
        data.status in ['paid', 'pending', 'failed', 'refunded'] &&
        data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 40 &&
        (!('providerSessionId' in data) || (data.providerSessionId is string && data.providerSessionId.size() <= 200)) &&
        (!('invoiceUrl' in data) || (data.invoiceUrl is string && data.invoiceUrl.size() <= 512)) &&
        data.createdAt is timestamp;
    }

    function isValidUserEntitlement(data, userId) {
      return data.keys().hasAll([
          'userId', 'planId', 'status', 'aiDailyLimit', 'maxHistoryRecords',
          'maxSavedDevices', 'cloudSyncEnabled', 'analyticsEnabled',
          'gamingModeEnabled', 'alertsEnabled', 'teamManagementEnabled', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'planId', 'status', 'aiDailyLimit', 'maxHistoryRecords',
          'maxSavedDevices', 'cloudSyncEnabled', 'analyticsEnabled',
          'gamingModeEnabled', 'alertsEnabled', 'teamManagementEnabled', 'updatedAt'
        ]) &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.planId in ['free', 'pro', 'business'] &&
        data.status in ['active', 'suspended', 'canceled'] &&
        data.aiDailyLimit is number && data.aiDailyLimit >= 0 &&
        data.maxHistoryRecords is number && data.maxHistoryRecords >= -1 &&
        data.maxSavedDevices is number && data.maxSavedDevices >= 0 &&
        data.cloudSyncEnabled is bool &&
        data.analyticsEnabled is bool &&
        data.gamingModeEnabled is bool &&
        data.alertsEnabled is bool &&
        data.teamManagementEnabled is bool &&
        data.updatedAt is timestamp;
    }

    function isValidUserDevice(data, userId, deviceId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'deviceType', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'deviceType', 'browserLabel', 'isp', 'connectionType', 'lastSeenAt', 'createdAt', 'updatedAt']) &&
        data.id == deviceId &&
        data.userId == userId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.deviceType in ['desktop', 'laptop', 'mobile', 'router', 'other'] &&
        (!('browserLabel' in data) || (data.browserLabel is string && data.browserLabel.size() <= 120)) &&
        (!('isp' in data) || (data.isp is string && data.isp.size() <= 120)) &&
        (!('connectionType' in data) || (data.connectionType is string && data.connectionType.size() <= 40)) &&
        (!('lastSeenAt' in data) || (data.lastSeenAt is timestamp)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCloudTestRecord(data, userId, testId) {
      return data.keys().hasAll([
          'id', 'userId', 'timestamp', 'downloadMbps', 'uploadMbps',
          'pingMs', 'jitterMs', 'serverId', 'serverName', 'status',
          'durationSec', 'bytesTransferred', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'timestamp', 'downloadMbps', 'uploadMbps',
          'pingMs', 'minPingMs', 'maxPingMs', 'jitterMs', 'probeLossPercent',
          'serverId', 'serverName', 'serverLocation', 'connectionType',
          'effectiveType', 'publicIp', 'isp', 'status', 'durationSec',
          'bytesTransferred', 'deviceId', 'notes', 'createdAt'
        ]) &&
        data.id == testId &&
        data.userId == userId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.timestamp is string && data.timestamp.size() >= 8 && data.timestamp.size() <= 64 &&
        data.downloadMbps is number && data.downloadMbps >= 0 && data.downloadMbps <= 100000 &&
        data.uploadMbps is number && data.uploadMbps >= 0 && data.uploadMbps <= 100000 &&
        data.pingMs is number && data.pingMs >= 0 && data.pingMs <= 60000 &&
        (!('minPingMs' in data) || (data.minPingMs is number && data.minPingMs >= 0)) &&
        (!('maxPingMs' in data) || (data.maxPingMs is number && data.maxPingMs >= 0)) &&
        data.jitterMs is number && data.jitterMs >= 0 && data.jitterMs <= 60000 &&
        (!('probeLossPercent' in data) || (data.probeLossPercent is number && data.probeLossPercent >= 0 && data.probeLossPercent <= 100)) &&
        data.serverId is string && data.serverId.size() >= 1 && data.serverId.size() <= 80 &&
        data.serverName is string && data.serverName.size() >= 1 && data.serverName.size() <= 120 &&
        (!('serverLocation' in data) || (data.serverLocation is string && data.serverLocation.size() <= 120)) &&
        (!('connectionType' in data) || (data.connectionType is string && data.connectionType.size() <= 40)) &&
        (!('effectiveType' in data) || (data.effectiveType is string && data.effectiveType.size() <= 40)) &&
        (!('publicIp' in data) || (data.publicIp is string && data.publicIp.size() <= 64)) &&
        (!('isp' in data) || (data.isp is string && data.isp.size() <= 120)) &&
        data.status in ['completed', 'partial', 'cancelled', 'failed'] &&
        data.durationSec is number && data.durationSec >= 0 &&
        data.bytesTransferred is number && data.bytesTransferred >= 0 &&
        (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        data.createdAt is timestamp;
    }

    function isValidMonitoringSnapshot(data, userId, recordId) {
      return data.keys().hasAll(['id', 'userId', 'avgLatencyMs', 'interruptions', 'onlinePercent', 'sampleCount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'avgLatencyMs', 'minLatencyMs', 'maxLatencyMs', 'interruptions', 'onlinePercent', 'sampleCount', 'createdAt']) &&
        data.id == recordId &&
        data.userId == userId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.avgLatencyMs is number && data.avgLatencyMs >= 0 &&
        (!('minLatencyMs' in data) || (data.minLatencyMs is number && data.minLatencyMs >= 0)) &&
        (!('maxLatencyMs' in data) || (data.maxLatencyMs is number && data.maxLatencyMs >= 0)) &&
        data.interruptions is number && data.interruptions >= 0 &&
        data.onlinePercent is number && data.onlinePercent >= 0 && data.onlinePercent <= 100 &&
        data.sampleCount is number && data.sampleCount >= 1 &&
        data.createdAt is timestamp;
    }

    function isValidAlertRule(data, userId, alertId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'metric', 'operator', 'threshold', 'enabled', 'channel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'metric', 'operator', 'threshold', 'enabled', 'channel', 'createdAt', 'updatedAt']) &&
        data.id == alertId &&
        data.userId == userId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.metric in ['download_mbps', 'upload_mbps', 'ping_ms', 'jitter_ms', 'packet_loss'] &&
        data.operator in ['lt', 'gt'] &&
        data.threshold is number && data.threshold >= 0 &&
        data.enabled is bool &&
        data.channel in ['in_app', 'browser'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAiUsageRecord(data, userId) {
      return data.keys().hasAll(['userId', 'dateKey', 'usedCount', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'dateKey', 'usedCount', 'updatedAt']) &&
        data.userId == userId &&
        isValidId(data.userId) &&
        data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 16 &&
        data.usedCount is number && data.usedCount >= 0 && data.usedCount <= 10000 &&
        data.updatedAt is timestamp;
    }

    function isValidOrganization(data, orgId) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'planId', 'status', 'maxSeats', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'ownerId', 'planId', 'status', 'maxSeats', 'createdAt', 'updatedAt']) &&
        data.id == orgId &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        isValidId(data.ownerId) &&
        data.planId == 'business' &&
        data.status in ['active', 'suspended'] &&
        data.maxSeats is number && data.maxSeats >= 1 && data.maxSeats <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganizationMember(data, orgId, memberId) {
      return data.keys().hasAll(['orgId', 'orgOwnerId', 'userId', 'displayName', 'role', 'status', 'addedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['orgId', 'orgOwnerId', 'userId', 'displayName', 'role', 'status', 'addedBy', 'createdAt', 'updatedAt']) &&
        data.orgId == orgId &&
        data.userId == memberId &&
        isValidId(data.orgId) &&
        isValidId(data.orgOwnerId) &&
        isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['owner', 'admin', 'manager', 'viewer'] &&
        data.status in ['active', 'invited', 'revoked'] &&
        isValidId(data.addedBy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganizationDevice(data, orgId, deviceId) {
      return data.keys().hasAll(['id', 'orgId', 'orgOwnerId', 'name', 'registeredBy', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'orgId', 'orgOwnerId', 'name', 'location', 'registeredBy', 'status', 'lastDownloadMbps', 'lastPingMs', 'createdAt', 'updatedAt']) &&
        data.id == deviceId &&
        data.orgId == orgId &&
        isValidId(data.id) &&
        isValidId(data.orgId) &&
        isValidId(data.orgOwnerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
        isValidId(data.registeredBy) &&
        data.status in ['online', 'offline', 'degraded'] &&
        (!('lastDownloadMbps' in data) || (data.lastDownloadMbps is number && data.lastDownloadMbps >= 0)) &&
        (!('lastPingMs' in data) || (data.lastPingMs is number && data.lastPingMs >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganizationActivityLog(data, orgId) {
      return data.keys().hasAll(['orgId', 'orgOwnerId', 'actorId', 'action', 'createdAt']) &&
        data.keys().hasOnly(['orgId', 'orgOwnerId', 'actorId', 'action', 'target', 'details', 'createdAt']) &&
        data.orgId == orgId &&
        isValidId(data.orgId) &&
        isValidId(data.orgOwnerId) &&
        isValidId(data.actorId) &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        (!('target' in data) || (data.target is string && data.target.size() <= 120)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 400)) &&
        data.createdAt is timestamp;
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'category', 'priority', 'status', 'message', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'subject', 'category', 'priority', 'status', 'message', 'adminResponse', 'createdAt', 'updatedAt']) &&
        data.id == ticketId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 140 &&
        data.category in ['technical', 'billing', 'account', 'business', 'bug'] &&
        data.priority in ['low', 'medium', 'high'] &&
        data.status in ['open', 'in_progress', 'resolved', 'closed'] &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 3000 &&
        (!('adminResponse' in data) || (data.adminResponse is string && data.adminResponse.size() <= 2000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        data.keys().hasOnly(['actorId', 'actorEmail', 'action', 'targetType', 'targetId', 'summary', 'createdAt']) &&
        isValidId(data.actorId) &&
        (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 200)) &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 100 &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 60 &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // DEFAULT DENY CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // CONNECTION PROBE SENTINEL
    // =========================================================================
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // =========================================================================
    // ADMIN REGISTRY
    // =========================================================================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isBootstrapAdmin() &&
        isValidAdminRegistry(incoming(), adminId) &&
        incoming().grantedAt == request.time;
      allow update, delete: if false;
    }

    // =========================================================================
    // GLOBAL SAAS CATALOG: PLANS, FEATURE FLAGS, COUPONS
    // =========================================================================
    match /plans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow create: if isValidId(planId) && isAdmin() &&
        isValidSubscriptionPlan(incoming(), planId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(planId) && isAdmin() &&
        isValidSubscriptionPlan(incoming(), planId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /featureFlags/{flagId} {
      allow get: if isValidId(flagId);
      allow list: if true;
      allow create: if isValidId(flagId) && isAdmin() &&
        isValidFeatureFlag(incoming(), flagId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(flagId) && isAdmin() &&
        isValidFeatureFlag(incoming(), flagId) &&
        incoming().key == existing().key &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(flagId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && isVerifiedUser();
      allow list: if isAdmin();
      allow create: if isValidId(couponId) && isAdmin() &&
        isValidCouponCode(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(couponId) && isAdmin() &&
        isValidCouponCode(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(couponId) && isAdmin();
    }

    // =========================================================================
    // USERS, PRIVATE PII, BILLING, ENTITLEMENTS & CLOUD TELEMETRY
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().accountStatus == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'language', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Strictly isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.uid == request.auth.uid);
        allow create: if isValidId(userId) && docId == 'info' && isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin()) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'country', 'marketingOptIn', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      }

      // Admin-controlled billing & entitlements (Users can read only, never self-upgrade!)
      match /subscriptions/{subscriptionId} {
        allow get: if isValidId(userId) && isValidId(subscriptionId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(subscriptionId) && isAdmin() &&
          isValidUserSubscription(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(subscriptionId) && isAdmin() &&
          isValidUserSubscription(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(subscriptionId) && isAdmin();
      }

      match /payments/{paymentId} {
        allow get: if isValidId(userId) && isValidId(paymentId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(paymentId) && isAdmin() &&
          isValidPaymentRecord(incoming(), userId) &&
          incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      match /entitlements/{entitlementId} {
        allow get: if isValidId(userId) && isValidId(entitlementId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && entitlementId == 'current' && isAdmin() &&
          isValidUserEntitlement(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && entitlementId == 'current' && isAdmin() &&
          isValidUserEntitlement(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(userId) && isValidId(entitlementId) && isAdmin();
      }

      // User Devices
      match /devices/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(deviceId) && isOwner(userId) &&
          isValidUserDevice(incoming(), userId, deviceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(deviceId) && isOwner(userId) &&
          isValidUserDevice(incoming(), userId, deviceId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'deviceType', 'browserLabel', 'isp', 'connectionType', 'lastSeenAt', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(deviceId) && isOwner(userId);
      }

      // Cloud Speed Test History
      match /testHistory/{testId} {
        allow get: if isValidId(userId) && isValidId(testId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(testId) && isOwner(userId) &&
          isValidCloudTestRecord(incoming(), userId, testId) &&
          incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(testId) && isOwner(userId) &&
          isValidCloudTestRecord(incoming(), userId, testId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['notes']);
        allow delete: if isValidId(userId) && isValidId(testId) && isOwner(userId);
      }

      // Live Monitoring Snapshots
      match /monitoringRecords/{recordId} {
        allow get: if isValidId(userId) && isValidId(recordId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(recordId) && isOwner(userId) &&
          isValidMonitoringSnapshot(incoming(), userId, recordId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(recordId) && isOwner(userId);
      }

      // Custom Alert Rules
      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(alertId) && isOwner(userId) &&
          isValidAlertRule(incoming(), userId, alertId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(alertId) && isOwner(userId) &&
          isValidAlertRule(incoming(), userId, alertId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'metric', 'operator', 'threshold', 'enabled', 'channel', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(alertId) && isOwner(userId);
      }

      // AI Daily Usage Counters (Non-decreasing per day for non-admins)
      match /aiUsage/{periodId} {
        allow get: if isValidId(userId) && isValidId(periodId) && (isOwner(userId) || isAdmin());
        allow list: if isAdmin() || (isOwner(userId) && resource.data.userId == request.auth.uid);
        allow create: if isValidId(userId) && isValidId(periodId) && isOwner(userId) &&
          isValidAiUsageRecord(incoming(), userId) &&
          incoming().usedCount <= 1 &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(periodId) &&
          isValidAiUsageRecord(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().dateKey == existing().dateKey &&
          incoming().updatedAt == request.time && (
            isAdmin() || (
              isOwner(userId) &&
              incoming().usedCount == existing().usedCount + 1 &&
              incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(periodId) && isAdmin();
      }
    }

    // =========================================================================
    // BUSINESS ORGANIZATIONS & MULTI-ROLE MEMBERS
    // =========================================================================
    match /{path=**}/members/{memberId} {
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
    }

    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (isAdmin() || existing().ownerId == request.auth.uid || isOrgMember(orgId));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(orgId) && isVerifiedUser() &&
        isValidOrganization(incoming(), orgId) &&
        incoming().ownerId == request.auth.uid &&
        hasBusinessEntitlement(request.auth.uid) &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(orgId) && isValidOrganization(incoming(), orgId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orgId) && (isAdmin() || (isVerifiedUser() && existing().ownerId == request.auth.uid));

      match /members/{memberId} {
        allow get: if isValidId(orgId) && isValidId(memberId) && (
          isAdmin() ||
          request.auth.uid == memberId ||
          isOrgMember(orgId) ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid
        );
        allow list: if isAdmin() || (
          isVerifiedUser() && (
            resource.data.orgOwnerId == request.auth.uid ||
            resource.data.userId == request.auth.uid
          )
        );
        allow create: if isValidId(orgId) && isValidId(memberId) && isVerifiedUser() &&
          isValidOrganizationMember(incoming(), orgId, memberId) &&
          exists(/databases/$(database)/documents/organizations/$(orgId)) &&
          incoming().orgOwnerId == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId &&
          incoming().addedBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
            hasOrgRole(orgId, ['owner', 'admin'])
          );
        allow update: if isValidId(orgId) && isValidId(memberId) && isVerifiedUser() &&
          isValidOrganizationMember(incoming(), orgId, memberId) &&
          incoming().orgId == existing().orgId &&
          incoming().orgOwnerId == existing().orgOwnerId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() || (
              (
                get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
                hasOrgRole(orgId, ['owner', 'admin'])
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'updatedAt'])
            )
          );
        allow delete: if isValidId(orgId) && isValidId(memberId) && (
          isAdmin() ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          hasOrgRole(orgId, ['owner', 'admin'])
        );
      }

      match /devices/{deviceId} {
        allow get: if isValidId(orgId) && isValidId(deviceId) && (
          isAdmin() ||
          isOrgMember(orgId) ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid
        );
        allow list: if isAdmin() || (isVerifiedUser() && resource.data.orgOwnerId == request.auth.uid);
        allow create: if isValidId(orgId) && isValidId(deviceId) && isVerifiedUser() &&
          isValidOrganizationDevice(incoming(), orgId, deviceId) &&
          exists(/databases/$(database)/documents/organizations/$(orgId)) &&
          incoming().orgOwnerId == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId &&
          incoming().registeredBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isAdmin() ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
            hasOrgRole(orgId, ['owner', 'admin', 'manager'])
          );
        allow update: if isValidId(orgId) && isValidId(deviceId) && isVerifiedUser() &&
          isValidOrganizationDevice(incoming(), orgId, deviceId) &&
          incoming().id == existing().id &&
          incoming().orgId == existing().orgId &&
          incoming().orgOwnerId == existing().orgOwnerId &&
          incoming().registeredBy == existing().registeredBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() || (
              (
                get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
                hasOrgRole(orgId, ['owner', 'admin', 'manager'])
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'status', 'lastDownloadMbps', 'lastPingMs', 'updatedAt'])
            )
          );
        allow delete: if isValidId(orgId) && isValidId(deviceId) && (
          isAdmin() ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
          hasOrgRole(orgId, ['owner', 'admin'])
        );
      }

      match /activityLogs/{logId} {
        allow get: if isValidId(orgId) && isValidId(logId) && (
          isAdmin() ||
          isOrgMember(orgId) ||
          get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid
        );
        allow list: if isAdmin() || (isVerifiedUser() && resource.data.orgOwnerId == request.auth.uid);
        allow create: if isValidId(orgId) && isValidId(logId) && isVerifiedUser() &&
          isValidOrganizationActivityLog(incoming(), orgId) &&
          exists(/databases/$(database)/documents/organizations/$(orgId)) &&
          incoming().orgOwnerId == get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId &&
          incoming().actorId == request.auth.uid &&
          incoming().createdAt == request.time && (
            isAdmin() ||
            get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid ||
            hasOrgRole(orgId, ['owner', 'admin', 'manager'])
          );
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // SUPPORT TICKETS
    // =========================================================================
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(ticketId) && isVerifiedUser() &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        !('adminResponse' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isVerifiedUser() &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().userId == request.auth.uid &&
            existing().status in ['open', 'in_progress'] &&
            incoming().status == 'closed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    // =========================================================================
    // ADMIN AUDIT LOGS (APPEND-ONLY)
    // =========================================================================
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() &&
        isValidAuditLog(incoming()) &&
        incoming().actorId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
