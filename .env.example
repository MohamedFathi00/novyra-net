# GEMINI_API_KEY: Required for NOVYRA AI Network Advisor calls on the backend.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# Supabase hosted project (the anon key is safe for the browser bundle).
VITE_SUPABASE_URL=https://qfsyrnhxqxbxufshuzoa.supabase.co
VITE_SUPABASE_ANON_KEY=

# APP_URL: The URL where this applet is hosted (used for Checkout return URLs and callbacks).
APP_URL=

# BILLING / STRIPE (Server-side only — never expose secrets to client bundle)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# TRANSACTIONAL EMAIL (Optional server-side notification adapter)
EMAIL_SERVICE_API_KEY=

# ADMIN_BOOTSTRAP_EMAIL: Verified Google/Firebase email granted server & rules admin privileges
ADMIN_BOOTSTRAP_EMAIL=me40351@gmail.com

